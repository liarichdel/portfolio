[32m+[m
[32m+[m[32m    let isDragging = false;[m
[32m+[m[32m    let startX, scrollLeftStart;[m
[32m+[m[32m    const speed = 0.5;[m[41m [m
[32m+[m
[32m+[m[32m    function autoScroll() {[m
[32m+[m[32m        if (!isDragging) {[m
[32m+[m[32m            wrapper.scrollLeft += speed;[m
[32m+[m[41m            [m
[32m+[m[32m            // Reset jika sudah setengah jalan[m
[32m+[m[32m            if (wrapper.scrollLeft >= (track.scrollWidth / 2)) {[m
[32m+[m[32m                wrapper.scrollLeft = 0;[m
[32m+[m[32m            }[m
[32m+[m[32m        }[m
[32m+[m[32m        requestAnimationFrame(autoScroll);[m
[32m+[m[32m    }[m
