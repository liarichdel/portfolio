[32m+[m
[32m+[m[32m    wrapper.addEventListener('mousedown', (e) => {[m
[32m+[m[32m        isDragging = true;[m
[32m+[m[32m        wrapper.classList.add('active');[m
[32m+[m[32m        startX = e.pageX - wrapper.offsetLeft;[m
[32m+[m[32m        scrollLeftStart = wrapper.scrollLeft;[m
[32m+[m[32m    });[m
[32m+[m
[32m+[m[32m    wrapper.addEventListener('mouseleave', () => {[m
[32m+[m[32m        isDragging = false;[m
[32m+[m[32m        wrapper.classList.remove('active');[m
[32m+[m[32m    });[m
[32m+[m
[32m+[m[32m    wrapper.addEventListener('mouseup', () => {[m
[32m+[m[32m        isDragging = false;[m
[32m+[m[32m        wrapper.classList.remove('active');[m
[32m+[m[32m    });[m
[32m+[m
[32m+[m[32m    wrapper.addEventListener('mousemove', (e) => {[m
[32m+[m[32m        if (!isDragging) return;[m
[32m+[m[32m        e.preventDefault();[m
[32m+[m[32m        const x = e.pageX - wrapper.offsetLeft;[m
[32m+[m[32m        const walk = (x - startX) * 2;[m
[32m+[m[32m        wrapper.scrollLeft = scrollLeftStart - walk;[m
[32m+[m[32m    });[m
[32m+[m
[32m+[m[32m    wrapper.addEventListener('touchstart', (e) => {[m
