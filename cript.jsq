[32m+[m[32mconst wrapper = document.getElementById('certWrapper');[m
[32m+[m[32mconst track = document.getElementById('certTrack');[m
[32m+[m
[32m+[m[32mif (wrapper && track) {[m
[32m+[m[32m    wrapper.style.scrollBehavior = 'auto';[m
